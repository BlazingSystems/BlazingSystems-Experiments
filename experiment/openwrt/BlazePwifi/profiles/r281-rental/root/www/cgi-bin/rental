#!/bin/sh
. "${BP_LIB:-/usr/lib/blazepwifi/common.sh}"
. "${BP_AUTH_LIB:-/usr/lib/blazepwifi/auth.sh}"
. "${BP_RENTAL_LIB:-/usr/lib/blazepwifi/rental.sh}"
bp_rental_init

action="$(bp_param action)"
nonce="$(bp_param nonce)"
sig="$(bp_param sig)"
now="$(bp_now)"
[ -n "$nonce" ] && [ -n "$sig" ] || bp_fail "missing authentication"

case "$action" in
  enroll)
    eid="$(bp_param enroll_id)"
    printf '%s' "$eid" | grep -Eq '^[0-9a-f]{12}$' || bp_fail "invalid enrollment id"
    # All requests spending a one-time setup QR are serialized before
    # inspecting the token. Otherwise two devices can enroll concurrently.
    bp_lock || bp_fail "enrollment accounting busy"
    line="$(bp_rental_enroll_lookup "$eid")"
    [ -n "$line" ] || { bp_unlock; bp_fail "enrollment invalid or used"; }
    secret="$(printf '%s' "$line" | cut -f2)"
    expiry="$(printf '%s' "$line" | cut -f3)"
    label="$(printf '%s' "$line" | cut -f4-)"
    [ "$expiry" -ge "$now" ] 2>/dev/null ||
      { bp_unlock; bp_fail "enrollment expired"; }
    printf '%s' "$secret" | LC_ALL=C grep -Eq '^[a-f0-9]{36}$' ||
      { bp_unlock; bp_fail "invalid enrollment identity; operator reconciliation required"; }
    token="$eid.$secret"
    expected="$(bp_rental_hmac "$token" "enroll|$nonce|$token")" ||
      { bp_unlock; bp_fail "rental crypto unavailable"; }
    [ "$sig" = "$expected" ] || { bp_unlock; bp_fail "authentication failed"; }
    did="$(bp_rental_hex 12)" || { bp_unlock; bp_fail "secure identity generation failed"; }
    dsecret="$(bp_rental_hex 24)" || { bp_unlock; bp_fail "secure identity generation failed"; }
    printf '%s' "$did" | LC_ALL=C grep -Eq '^[0-9a-f]{24}$' ||
      { bp_unlock; bp_fail "invalid generated device identity"; }
    printf '%s' "$dsecret" | LC_ALL=C grep -Eq '^[0-9a-f]{48}$' ||
      { bp_unlock; bp_fail "invalid generated device key"; }
    [ -z "$(bp_rental_device_line "$did")" ] ||
      { bp_unlock; bp_fail "random identity collision; retry securely"; }
    # v1 containment only: the identity/policy/token live in three separate
    # TSVs. If one commits and another fails, the persistent marker stops
    # further setup and payments until an operator inspects the records.
    bp_paid_begin || { bp_unlock; bp_fail "paid state uncertain; operator reconciliation required"; }
    if ! bp_rental_device_write "$did" "$dsecret" 0 "${label:-Rental phone}" "$now" ||
       ! bp_rental_policy_ensure "$did" ||
       ! bp_rental_enroll_consume "$eid"; then
      bp_paid_abort
      bp_unlock
      bp_fail "rental enrollment persistence uncertain; operator reconciliation required"
    fi
    if ! bp_paid_commit; then
      bp_unlock
      bp_fail "rental enrollment durability uncertain; operator reconciliation required"
    fi
    bp_unlock
    # The one-time QR is consumed and the device+policy are stored. Never
    # disclose a newly minted device secret on any failed earlier stage.
    bp_json "$(printf '{"ok":true,"device_id":"%s","device_secret":"%s","server_time_ms":%s,"lease_until_ms":%s}' "$did" "$dsecret" "$((now*1000))" "$((now*1000))")"
    ;;
  status)
    did="$(bp_param device_id)"
    printf '%s' "$did" | grep -Eq '^[0-9a-f]{24}$' || bp_fail "invalid device id"
    line="$(bp_rental_device_line "$did")"
    [ -n "$line" ] || bp_fail "unknown device"
    secret="$(printf '%s' "$line" | cut -f2)"
    lease="$(printf '%s' "$line" | cut -f3)"
    label="$(printf '%s' "$line" | cut -f4)"
    expected="$(bp_rental_hmac "$secret" "status|$nonce|$secret")" || bp_fail "rental crypto unavailable"
    [ "$sig" = "$expected" ] || bp_fail "authentication failed"
    inventory="$(bp_param inventory)"
    [ -z "$inventory" ] || bp_rental_inventory_write "$did" "$inventory" || bp_fail "invalid app inventory"
    # Never rewrite authoritative paid lease with a snapshot from before
    # enrollment/inventory work: a concurrent coin credit may have landed.
    # Last-seen is ephemeral, not financial data.
    live="$(bp_rental_device_line "$did")"
    [ -n "$live" ] || bp_fail "rental identity missing after authentication"
    live_secret="$(printf '%s' "$live" | cut -f2)"
    [ "$live_secret" = "$secret" ] || bp_fail "rental identity changed; re-enroll securely"
    lease="$(printf '%s' "$live" | cut -f3)"
    case "$lease" in ''|*[!0-9]*) bp_fail "invalid paid rental lease; operator reconciliation required";; esac
    bp_rental_seen_update "$did" "$now" || bp_fail "rental presence update failed; retry status"
    policy="$(bp_rental_policy_line "$did")"
    allowed="$(printf '%s' "$policy" | cut -f2)"
    salt="$(printf '%s' "$policy" | cut -f3)"
    hash="$(printf '%s' "$policy" | cut -f4)"
    rounds="$(printf '%s' "$policy" | cut -f5)"
    preferred="$(printf '%s' "$policy" | cut -f6)"
    [ "$salt" = "-" ] && salt=""
    [ "$hash" = "-" ] && hash=""
    [ "$preferred" = "-" ] && preferred=""
    per="$(bp_cfg rental_seconds_per_pulse)"
    [ -n "$per" ] || per=600
    server_ms=$((now*1000))
    # Keep expired devices synchronized. The authoritative stored lease remains
    # expired; only the signed report is clamped to server-now because the
    # Android client rejects lease_until_ms values older than server_time_ms.
    report_lease="${lease:-0}"
    [ "$report_lease" -ge "$now" ] 2>/dev/null || report_lease="$now"
    lease_ms=$((report_lease*1000))
    canonical="$did|$nonce|$server_ms|$lease_ms|$allowed|$salt|$hash|$rounds|$preferred|$per"
    psig="$(bp_rental_hmac "$secret" "$canonical")" || bp_fail "rental crypto unavailable"
    bp_json "$(printf '{"ok":true,"device_id":"%s","server_time_ms":%s,"lease_until_ms":%s,"allowed_packages":"%s","admin_salt":"%s","admin_hash":"%s","admin_rounds":%s,"preferred_vendo":"%s","rental_seconds_per_pulse":%s,"policy_sig":"%s"}' "$did" "$server_ms" "$lease_ms" "$(bp_json_escape "$allowed")" "$(bp_json_escape "$salt")" "$(bp_json_escape "$hash")" "${rounds:-4096}" "$(bp_json_escape "$preferred")" "$per" "$psig")"
    ;;
  coin_start)
    did="$(bp_param device_id)"
    printf '%s' "$did" | grep -Eq '^[0-9a-f]{24}$' || bp_fail "invalid device id"
    line="$(bp_rental_device_line "$did")"
    [ -n "$line" ] || bp_fail "unknown device"
    secret="$(printf '%s' "$line" | cut -f2)"
    expected="$(bp_rental_hmac "$secret" "coin_start|$nonce|$secret")" || bp_fail "rental crypto unavailable"
    [ "$sig" = "$expected" ] || bp_fail "authentication failed"
    bp_time_sane "$now" || bp_fail "router clock not synchronized"
    policy="$(bp_rental_policy_line "$did")"
    preferred="$(printf '%s' "$policy" | cut -f6)"
    [ "$preferred" = "-" ] && preferred=""
    vendo="$(bp_param vendo)"
    [ -n "$vendo" ] || vendo="$preferred"
    [ -n "$vendo" ] || vendo="$(bp_choose_vendo 2>/dev/null || true)"
    [ -n "$vendo" ] || bp_fail "select a controller or wait for one to come online"
    printf '%s' "$vendo" | grep -Eq '^[A-Za-z0-9._-]{1,48}$' || bp_fail "invalid controller"
    window="$(bp_cfg coin_window)"
    [ -n "$window" ] || window=120
    case "$window" in ''|*[!0-9]*) bp_fail "invalid coin window configuration";; esac
    [ "$window" -ge 1 ] 2>/dev/null && [ "$window" -le 3600 ] 2>/dev/null ||
      bp_fail "coin window out of range"
    expires=$((now+window))
    target_file="$BP_TARGET_DIR/$vendo.tsv"
    bp_lock || bp_fail "accounting busy"
    # A real coin credit may have ended in an ambiguous paid/audit write.
    # Never open another acceptor until a privileged reconciliation.
    if [ -e "$BP_PAID_UNCERTAIN" ] || [ -L "$BP_PAID_UNCERTAIN" ]; then
      bp_unlock
      bp_fail "paid state uncertain; operator reconciliation required"
    fi
    if [ -L "$target_file" ]; then
      bp_unlock
      bp_fail "unsafe coin target file; operator reconciliation required"
    fi
    if [ -f "$target_file" ]; then
      IFS="$(printf '\t')" read -r old_device old_mac old_nonce old_expires old_vendo old_kind < "$target_file"
      old_kind="${old_kind:-hotspot}"
      case "$old_expires" in ''|*[!0-9]*)
        bp_unlock; bp_fail "malformed coin window; operator reconciliation required";;
      esac
      printf '%s' "$old_nonce" | LC_ALL=C grep -Eq '^[a-fA-F0-9]{8,32}$' ||
        { bp_unlock; bp_fail "malformed coin target nonce; operator reconciliation required"; }
      if [ "$old_expires" -gt "$now" ] 2>/dev/null; then
        if [ "$old_device" != "$did" ] || [ "$old_kind" != rental ] || [ "$old_vendo" != "$vendo" ]; then
          bp_unlock
          bp_fail "selected controller is busy"
        fi
        # Repeated Android setup/HTTP retries MUST return the original
        # target nonce. Physical coins may already be pending on controller.
        bp_unlock
        bp_json "$(printf '{"ok":true,"vendo":"%s","target_nonce":"%s","expires":%s}' "$(bp_json_escape "$vendo")" "$old_nonce" "$old_expires")"
        exit 0
      fi
    fi
    target_nonce="$(hexdump -n 8 -e '8/1 "%02x"' /dev/urandom 2>/dev/null || printf '%s' "$now")"
    target_tmp="$BP_TARGET_DIR/.$vendo.$(bp_tmp_suffix)"
    # A target can admit real coins; treat its persistence as a financial
    # boundary even though this is still a split-file legacy protocol.
    bp_paid_begin || { bp_unlock; bp_fail "paid state uncertain or accounting busy"; }
    if ! printf '%s\t-\t%s\t%s\t%s\trental\n' "$did" "$target_nonce" "$expires" "$vendo" > "$target_tmp" ||
       ! chmod 600 "$target_tmp" ||
       ! mv "$target_tmp" "$target_file"; then
      rm -f "$target_tmp" 2>/dev/null || true
      bp_paid_abort
      bp_unlock
      bp_fail "could not persist coin window; operator reconciliation required"
    fi
    if ! bp_paid_commit; then
      bp_unlock
      bp_fail "coin window durability failed; operator reconciliation required"
    fi
    bp_unlock
    bp_json "$(printf '{"ok":true,"vendo":"%s","target_nonce":"%s","expires":%s}' "$(bp_json_escape "$vendo")" "$target_nonce" "$expires")"
    ;;
  *) bp_fail "unknown rental action" ;;
esac
