#!/bin/sh
. "${BP_LIB:-/usr/lib/blazepwifi/common.sh}"
. "${BP_AUTH_LIB:-/usr/lib/blazepwifi/auth.sh}"
{ [ "${HTTPS:-}" = on ] || [ "${SERVER_PORT:-}" = 443 ]; } || bp_fail "rental administration requires HTTPS"
if bp_auth_require_role viewer; then :; else bp_fail "unauthorized"; fi
bp_json "$(printf '{"ok":true,"username":"%s","role":"%s","csrf":"%s","must_change":%s}' "$(bp_json_escape "$BP_AUTH_USER")" "$(bp_json_escape "$BP_AUTH_ROLE")" "$BP_AUTH_CSRF" "${BP_AUTH_MUST_CHANGE:-0}")"
