#!/bin/sh
. "${BP_LIB:-/usr/lib/blazepwifi/common.sh}"
. "${BP_AUTH_LIB:-/usr/lib/blazepwifi/auth.sh}"
{ [ "${HTTPS:-}" = on ] || [ "${SERVER_PORT:-}" = 443 ]; } || bp_fail "rental administration requires HTTPS"
[ "${REQUEST_METHOD:-GET}" = POST ] || bp_fail "POST required"
if bp_auth_require_role viewer; then :; else bp_fail "unauthorized"; fi
bp_auth_csrf_ok || bp_fail "csrf validation failed"
bp_auth_lock || bp_fail "authentication busy"
if ! bp_auth_logout "$BP_AUTH_TOKEN" "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}"; then
  bp_auth_unlock
  bp_fail "logout did not revoke the server session; operator reconciliation required"
fi
bp_auth_unlock
printf 'Content-Type: application/json\r\nCache-Control: no-store\r\nSet-Cookie: blaze_admin=; Path=/; Secure; HttpOnly; SameSite=Strict; Max-Age=0\r\n\r\n{"ok":true}\n'
