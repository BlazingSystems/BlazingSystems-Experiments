#!/bin/sh
. "${BP_LIB:-/usr/lib/blazepwifi/common.sh}"
bp_init_dirs
bp_check_admin || bp_fail "unauthorized admin"
action="$(bp_param action)"; now="$(bp_now)"
case "$action" in
  status)
    sessions="$(awk -F '\t' -v n="$now" '$2>n {c++} END{print c+0}' "$BP_SESSIONS")"
    vendos="$(awk -F '\t' -v n="$now" '$2>(n-90) {c++} END{print c+0}' "$BP_VENDOS")"
    free_kb="$(awk '/MemAvailable:/ {print $2; found=1} END{if(!found) print 0}' /proc/meminfo)"
    load="$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)"; uptime="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
    bp_json "{\"ok\":true,\"active_sessions\":$sessions,\"online_vendos\":$vendos,\"mem_available_kb\":${free_kb:-0},\"load1\":\"${load:-0}\",\"uptime_seconds\":${uptime:-0}}"
    ;;
  voucher_create)
    cents="$(bp_param cents)"; case "$cents" in ''|*[!0-9]*) bp_fail "invalid amount";; esac
    code="$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' | tr 'a-f' 'A-F')"
    [ ${#code} -eq 16 ] || bp_fail "random source unavailable"
    printf '%s\t%s\t\t\n' "$code" "$cents" >> "$BP_VOUCHERS"
    bp_json "{\"ok\":true,\"code\":\"$code\",\"cents\":$cents}"
    ;;
  *) bp_fail "unknown admin action" ;;
esac
