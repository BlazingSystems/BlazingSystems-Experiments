config core 'main'
	option enabled '1'
	option capability_tier 'auto'
	option lan_if 'br-lan'
	option portal_port '8080'
	option vendo_port '4455'
	option admin_port '8443'
	option coin_window '120'
	option pulse_value_centavos '100'
	option event_history '64'
	option pause_max_seconds '0'
	option walled_refresh_seconds '120'
	option durable_sync '1'
	option firewall_zone 'lan'
	option admin_user 'admin'
	# Secrets are generated during first installation/provisioning.
	# Optional examples:
	# list walled_domain 'payments.example.com'
	# list walled_ip '203.0.113.10'

config rate 'p1'
	option cents '100'
	option seconds '600'
	option label 'P1 / 10 minutes'

config rate 'p5'
	option cents '500'
	option seconds '3600'
	option label 'P5 / 1 hour'

config rate 'p10'
	option cents '1000'
	option seconds '10800'
	option label 'P10 / 3 hours'
