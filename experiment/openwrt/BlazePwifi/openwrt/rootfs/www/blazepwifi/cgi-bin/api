#!/bin/sh
. "${BP_LIB:-/usr/lib/blazepwifi/common.sh}"
bp_init_dirs

action="$(bp_param action)"
ipaddr="${REMOTE_ADDR:-0.0.0.0}"
mac="$(bp_mac_for_ip "$ipaddr")"
[ -n "$mac" ] || mac="$(bp_param mac)"
mac="$(bp_mac_norm "$mac" 2>/dev/null || true)"

case "$action" in
  rates)
    bp_json "{\"ok\":true,\"rates\":$(bp_rates_json)}"
    ;;
  me)
    [ -n "$mac" ] || bp_fail "client MAC not resolved"
    credit="$(bp_get_credit "$mac")"; expiry="$(bp_get_session_expiry "$mac")"; now="$(bp_now)"
    remaining=0; [ "$expiry" -gt "$now" ] 2>/dev/null && remaining=$((expiry-now))
    bp_json "{\"ok\":true,\"mac\":\"$mac\",\"ip\":\"$(bp_json_escape "$ipaddr")\",\"credit_cents\":$credit,\"remaining_seconds\":$remaining}"
    ;;
  coin_start)
    [ -n "$mac" ] || bp_fail "client MAC not resolved"
    now="$(bp_now)"; window="$(bp_cfg coin_window)"; [ -n "$window" ] || window=120
    expires=$((now+window)); vendo="$(bp_param vendo)"; nonce="$(hexdump -n 6 -e '6/1 "%02x"' /dev/urandom 2>/dev/null || printf '%s' "$now")"
    printf '%s\t%s\t%s\t%s\n' "$mac" "$nonce" "$expires" "$vendo" > "$BP_TARGET"; chmod 600 "$BP_TARGET"
    bp_json "{\"ok\":true,\"nonce\":\"$nonce\",\"expires\":$expires}"
    ;;
  coin_stop)
    [ -n "$mac" ] || bp_fail "client MAC not resolved"
    if [ -f "$BP_TARGET" ] && [ "$(cut -f1 "$BP_TARGET")" = "$mac" ]; then rm -f "$BP_TARGET"; fi
    bp_json '{"ok":true}'
    ;;
  connect)
    [ -n "$mac" ] || bp_fail "client MAC not resolved"
    cents="$(bp_param cents)"; case "$cents" in ''|*[!0-9]*) bp_fail "invalid rate";; esac
    sec="$(bp_rate_seconds "$cents" 2>/dev/null || true)"; [ -n "$sec" ] || bp_fail "rate not configured"
    credit="$(bp_get_credit "$mac")"; [ "$credit" -ge "$cents" ] || bp_fail "insufficient credit"
    bp_lock || bp_fail "accounting busy"
    credit="$(bp_get_credit "$mac")"; [ "$credit" -ge "$cents" ] || { bp_unlock; bp_fail "insufficient credit"; }
    bp_set_credit "$mac" $((credit-cents))
    now="$(bp_now)"; expiry="$(bp_get_session_expiry "$mac")"; [ "$expiry" -lt "$now" ] 2>/dev/null && expiry="$now"
    expiry=$((expiry+sec)); bp_set_session "$mac" "$expiry" "$ipaddr"; bp_unlock
    bp_authorize_mac "$mac"
    bp_json "{\"ok\":true,\"credit_cents\":$((credit-cents)),\"expiry\":$expiry}"
    ;;
  disconnect)
    [ -n "$mac" ] || bp_fail "client MAC not resolved"
    bp_set_session "$mac" "$(bp_now)" "$ipaddr"; bp_deauthorize_mac "$mac"
    bp_json '{"ok":true}'
    ;;
  redeem)
    [ -n "$mac" ] || bp_fail "client MAC not resolved"
    code="$(bp_param code)"; printf '%s' "$code" | grep -Eq '^[A-Za-z0-9-]{4,32}$' || bp_fail "invalid voucher"
    bp_lock || bp_fail "accounting busy"
    line="$(awk -F '\t' -v c="$code" '$1==c && $3=="" {print; exit}' "$BP_VOUCHERS")"
    [ -n "$line" ] || { bp_unlock; bp_fail "voucher invalid or used"; }
    cents="$(printf '%s' "$line" | cut -f2)"; now="$(bp_now)"; tmp="$BP_RUN/vouchers.$$"
    awk -F '\t' -v OFS='\t' -v c="$code" -v m="$mac" -v n="$now" '$1==c && $3=="" {$3=m;$4=n} {print}' "$BP_VOUCHERS" > "$tmp" && mv "$tmp" "$BP_VOUCHERS"
    old="$(bp_get_credit "$mac")"; bp_set_credit "$mac" $((old+cents)); bp_unlock
    bp_json "{\"ok\":true,\"credit_cents\":$((old+cents))}"
    ;;
  *) bp_fail "unknown action" ;;
esac
