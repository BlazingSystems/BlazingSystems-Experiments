#!/bin/sh
. "${BP_LIB:-/usr/lib/blazepwifi/common.sh}"

setup_nft() {
	lan_if="$(bp_cfg lan_if)"; [ -n "$lan_if" ] || lan_if=br-lan
	portal="$(bp_cfg portal_port)"; [ -n "$portal" ] || portal=8080
	nft delete table inet blazepwifi 2>/dev/null || true
	nft -f - <<NFT
table inet blazepwifi {
  set auth_macs { type ether_addr; }
  set walled_v4 { type ipv4_addr; flags interval; }
  set walled_v6 { type ipv6_addr; flags interval; }

  chain captive {
    type nat hook prerouting priority -105; policy accept;
    iifname "$lan_if" ether saddr @auth_macs return
    iifname "$lan_if" ip daddr @walled_v4 return
    iifname "$lan_if" ip6 daddr @walled_v6 return
    iifname "$lan_if" tcp dport 80 redirect to :$portal
  }

  chain gate {
    type filter hook forward priority 10; policy accept;
    iifname "$lan_if" ether saddr @auth_macs accept
    iifname "$lan_if" ip daddr @walled_v4 accept
    iifname "$lan_if" ip6 daddr @walled_v6 accept
    iifname "$lan_if" drop
  }
}
NFT
}

sync_accounts() {
	now="$(bp_now)"
	if ! bp_time_sane "$now"; then
		nft flush set inet blazepwifi auth_macs 2>/dev/null || true
		return 0
	fi
	while IFS="$(printf '\t')" read -r device credit expiry remaining paused pause_started mac ipaddr events; do
		[ -n "$device" ] || continue
		if [ "$paused" = 1 ]; then
			bp_deauthorize_mac "$mac"
			continue
		fi
		if [ -n "$expiry" ] && [ "$expiry" -gt "$now" ] 2>/dev/null; then
			bp_authorize_mac "$mac"
		else
			bp_deauthorize_mac "$mac"
		fi
	done < "$BP_ACCOUNTS"
}

add_walled_ip() {
	ipaddr="$1"
	if printf '%s' "$ipaddr" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
		nft add element inet blazepwifi walled_v4 "{ $ipaddr }" 2>/dev/null || true
	elif printf '%s' "$ipaddr" | grep -q ':'; then
		nft add element inet blazepwifi walled_v6 "{ $ipaddr }" 2>/dev/null || true
	fi
}

sync_walled() {
	nft flush set inet blazepwifi walled_v4 2>/dev/null || true
	nft flush set inet blazepwifi walled_v6 2>/dev/null || true

	for ipaddr in $(bp_cfg walled_ip 2>/dev/null || true); do add_walled_ip "$ipaddr"; done
	for domain in $(bp_cfg walled_domain 2>/dev/null || true); do
		nslookup "$domain" 127.0.0.1 2>/dev/null | awk '
			/^Address [0-9]+: / {print $3}
			/^Address: / {print $2}
		' | while IFS= read -r ipaddr; do
			[ "$ipaddr" = "127.0.0.1" ] && continue
			[ "$ipaddr" = "::1" ] && continue
			add_walled_ip "$ipaddr"
		done
	done
}

cleanup_targets() {
	now="$(bp_now)"
	for target_file in "$BP_TARGET_DIR"/*.tsv; do
		[ -f "$target_file" ] || continue
		IFS="$(printf '\t')" read -r device mac nonce expires vendo < "$target_file"
		case "$expires" in ''|*[!0-9]*) rm -f "$target_file"; continue;; esac
		[ "$expires" -gt "$now" ] 2>/dev/null || rm -f "$target_file"
	done
}

bp_init_dirs
cleanup_targets
setup_nft || exit 1
sync_walled
trap 'nft delete table inet blazepwifi 2>/dev/null || true; exit 0' TERM INT
last_walled=0
last_target_cleanup=0
while :; do
	sync_accounts
	now="$(bp_now)"
	if [ $((now-last_target_cleanup)) -ge 30 ]; then
		cleanup_targets
		last_target_cleanup="$now"
	fi
	refresh="$(bp_cfg walled_refresh_seconds)"; [ -n "$refresh" ] || refresh=120
	if [ $((now-last_walled)) -ge "$refresh" ]; then
		sync_walled
		last_walled="$now"
	fi
	sleep 5
done
