import {cursor} from 'uci';
import {applyUplink} from '/usr/share/blaze/uplink.uc';
function check(ok,msg){if(!ok)die(msg);}
let u=cursor(ARGV[0]);
let p={radio:'radio1',ssid:'Fixture upstream',encryption:'none',password:'',channel:36,mode:'relay',captive:true,backup:true};
applyUplink(u,p);
check(u.get('network','blaze_relay','proto')=='relay','Missing DHCP relay');
check(u.get('dhcp','lan','ignore')=='1','Local DHCP must be disabled on relay clients');
check(u.get('firewall','blaze_wifiwan','masq')=='0','Relay traffic must not be NATed');
check(u.get('wireless','blaze_backup','network')=='blaze_backup','Missing independent backup AP');
check(u.get('blaze','main','wifi_captive')=='1','Captive policy lost');
check(u.get('firewall','blaze_wifiwan_dhcp','dest_port')=='68','Missing DHCP renewal rule');
p.mode='routed';p.backup=false;applyUplink(u,p);
check(!u.get('network','blaze_relay'),'Relay not removed');
check(u.get('dhcp','lan','ignore')!='1','DHCP not restored');
check(u.get('dhcp','lan','ra')=='server','IPv6 RA not restored');
check(u.get('firewall','blaze_wifiwan','masq')=='1','Routed uplink needs NAT');
check(!u.get('network','blaze_backup'),'Backup interface leaked after mode change');
applyUplink(u,{disconnect:true});
check(!u.get('wireless','blaze_sta'),'STA not removed');
check(!u.get('network','wifiwan'),'Wi-Fi WAN not removed');
check(u.get('wireless','radio1','channel')=='36','Original radio channel not restored');
let originalDhcp=u.get('dhcp','lan','ignore');
p.mode='relay';p.scope='ssid';p.repeat_ssid='Fixture-Repeater';p.backup=true;applyUplink(u,p);
check(u.get('network','wifiwan','peerdns')=='0','Dedicated repeater changed home DNS');
check(u.get('dhcp','lan','ignore')==originalDhcp,'Dedicated repeater changed LAN DHCP');
check(u.get('network','blaze_repeat','device')=='br-blaze-repeat','Dedicated bridge missing');
check(join(' ',u.get('network','blaze_relay','network'))=='blaze_repeat wifiwan','Relay includes home LAN');
check(u.get('firewall','blaze_wifiwan_forward','src')=='blaze_repeat','Home LAN redirected to repeater');
check(!u.get('network','blaze_backup'),'Dedicated mode must use existing home LAN as backup');
applyUplink(u,{disconnect:true});
check(!u.get('network','blaze_repeat'),'Dedicated bridge leaked after disconnect');
print('PASS: relay/routed/disconnect, DHCP restoration, backup isolation, captive policy and NAT configuration\n');
