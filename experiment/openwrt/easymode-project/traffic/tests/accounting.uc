import {delta, uniqueWAN, observeDNS, attribution, appFor, advance} from '../root/usr/share/easymode-traffic/accounting.uc';
let n=0;function equal(a,b,label){n++;if(sprintf('%J',a)!=sprintf('%J',b))die(label+': '+sprintf('%J != %J',a,b));}
equal(delta(100,250,true,64),150,'counter delta');equal(delta(250,10,true,64),0,'reset');equal(delta(100,250,false,64),0,'boot gap');equal(delta(4294967290,6,true,32),12,'32-bit wrap');
let wan=uniqueWAN([{interface:'wan',l3_device:'eth0.2',up:true,route:[{target:'0.0.0.0',mask:0}]},{interface:'wan6',l3_device:'eth0.2',up:true,route:[{target:'::',mask:0}]}],[],'router');equal(length(wan),1,'dual stack no double count');equal(uniqueWAN([{up:true,l3_device:'br-lan',route:[{target:'0.0.0.0',mask:0}]}],[],'ap'),[],'AP no fabricated WAN');
let dns=observeDNS({},['dnsmasq[123]: 7 192.168.1.2/53000 query[A] youtube.com from 192.168.1.2','dnsmasq[123]: 7 192.168.1.2/53000 reply youtube.com is 1.2.3.4'],100,10);
equal(attribution(dns,'192.168.1.2','1.2.3.4',110).app,'YouTube','DNS flow association');equal(attribution(dns,'192.168.1.3','1.2.3.4',110).domain,'Other/Unknown','client isolation');equal(attribution(dns,'192.168.1.2','1.2.3.4',161).domain,'Other/Unknown','expired association');
dns=observeDNS(dns,['dnsmasq[123]: 8 192.168.1.2/53000 query[A] other.test from 192.168.1.2','dnsmasq[123]: 8 192.168.1.2/53000 reply other.test is 1.2.3.4'],110,10);equal(attribution(dns,'192.168.1.2','1.2.3.4',115).domain,'Other/Unknown','shared address uncertain');equal(appFor('notyoutube.com'),'Unknown applications','suffix boundary');
let cfg={interval:15,retention:7,limit:64,domains:false},s={boot:'a',time:86400,monotonic:10,wan:[{device:'wan',identity:'2',rx:1000,tx:100}],clients:[],capabilities:{flow_generation:'a'}};
let a=advance({},s,cfg);s.time+=15;s.monotonic+=15;s.wan[0].rx+=1500;s.wan[0].tx+=300;let b=advance(a,s,cfg);equal(b.days['1'].wan.wan,{download:1500,upload:300},'WAN direction');equal(b.live[-1].download_bps,800,'bits per second');s.boot='b';s.monotonic=1;s.wan[0].rx=2000;let c=advance(b,s,cfg);equal(c.days['1'].wan.wan.download,1500,'reboot no duplicate');
let mac='02:00:00:00:00:01';s.clients=[{mac,ip:'192.168.1.2',online:true}];s.flows=[{key:'up',bytes:100,client_id:mac,client:'192.168.1.2',remote:'1.2.3.4',direction:'upload'}];c=advance(c,s,cfg);s.monotonic+=15;s.time+=15;s.flows[0].bytes=170;let d=advance(c,s,cfg);equal(d.devices[mac].upload,70,'per device upload');equal(length(keys(d.domains)),0,'domain disabled');s.flows[0].bytes=3;s.monotonic+=15;s.time+=15;let e=advance(d,s,cfg);equal(e.devices[mac].upload,70,'flow reset');
print('PASS: '+n+' accounting/attribution assertions\n');
